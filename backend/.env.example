SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Database. Default is a local SQLite file (fine for development).
# To use Neon: create a project at neon.tech, click "Connect", copy the
# connection string and paste it here exactly as shown, e.g.
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Tables are created automatically on first start.
DATABASE_URL=sqlite:///./app.db
COMPANY_ACCOUNT_EMAIL=company@autotrust.com
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Image storage. Fill in all three (cloudinary.com/console) to store vehicle
# photos on Cloudinary; leave empty to use local disk (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Where the website lives (used for links in emails).
FRONTEND_URL=http://localhost:3100
# "development" prints emails (e.g. verification links) in the server console
# when SMTP isn't configured. Use "production" when deployed.
APP_ENV=development

# Outgoing email via any SMTP server (Gmail app password, Brevo, Zoho, SES...).
# Leave SMTP_HOST empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AutoTrust <no-reply@autotrust.com>

# Where buyers send their bank transfer. Purchases are switched off until all
# three are filled in. AutoTrust keeps PLATFORM_FEE_RATE (5%) and pays the
# rest to the seller after handover.
COMPANY_BANK_NAME=
COMPANY_BANK_ACCOUNT_NUMBER=
COMPANY_BANK_ACCOUNT_NAME=
PLATFORM_FEE_RATE=0.05
